<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>PhotoHarbor</Name>
  <Repository>ghcr.io/bartel1234/fotoarkiv:0.2.0-beta.8</Repository>
  <Registry>https://github.com/Bartel1234/fotoarkiv/pkgs/container/fotoarkiv</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Shell>sh</Shell>
  <Support>https://github.com/Bartel1234/fotoarkiv/issues</Support>
  <Project>https://github.com/Bartel1234/fotoarkiv</Project>
  <Overview>PhotoHarbor: local backup for Google Photos with multiple accounts, albums, media browsing and ZIP downloads. Single-container beta for amd64. Set a password of at least 12 characters and choose your backup folders.</Overview>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <ExtraParams>--shm-size=1g --stop-timeout=60</ExtraParams>
  <Config Name="Web portal" Target="8787" Default="8787" Mode="tcp" Description="Portal port" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Control data" Target="/control" Default="/mnt/user/appdata/fotoarkiv-backup/control" Mode="rw" Description="Schedules, logs and indexes" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/fotoarkiv-backup/control</Config>
  <Config Name="Account profiles" Target="/accounts" Default="/mnt/user/appdata/fotoarkiv-backup/accounts" Mode="rw" Description="Private Google account profiles" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/fotoarkiv-backup/accounts</Config>
  <Config Name="Original profile" Target="/config" Default="/mnt/user/appdata/fotoarkiv-backup/chrome" Mode="rw" Description="Original account browser profile" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/fotoarkiv-backup/chrome</Config>
  <Config Name="Backup files" Target="/download" Default="/mnt/user/GoogleFotosBackup" Mode="rw" Description="Photos and videos; retain this folder when removing the container" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/GoogleFotosBackup</Config>
  <Config Name="Portal password" Target="APP_PASSWORD" Default="" Mode="" Description="Required: at least 12 characters" Type="Variable" Display="always" Required="true" Mask="true" />
  <Config Name="Timezone" Target="TZ" Default="Europe/Copenhagen" Mode="" Description="Scheduling timezone" Type="Variable" Display="always" Required="true" Mask="false">Europe/Copenhagen</Config>
  <Config Name="Backup hour" Target="SYNC_HOUR" Default="3" Mode="" Description="Daily backup hour, 0-23" Type="Variable" Display="always" Required="true" Mask="false">3</Config>
  <Config Name="Browser resolution" Target="RESOLUTION" Default="1280x800" Mode="" Description="Sign-in browser resolution" Type="Variable" Display="always" Required="true" Mask="false">1280x800</Config>
  <Icon>https://raw.githubusercontent.com/Bartel1234/fotoarkiv/v0.2.0-beta.8/dashboard/photoharbor-512.png</Icon>
</Container>

